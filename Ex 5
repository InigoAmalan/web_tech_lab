<h2>4. Currency Converter</h2>

Enter Amount:
<input type="text" id="amount">

<br><br>

From:

<select id="source">
    <option>Indian Rupee</option>
    <option>US Dollar</option>
</select>

&nbsp; To: &nbsp;

<select id="target">
    <option>US Dollar</option>
    <option>Indian Rupee</option>
</select>

<br><br>

<button onclick="changeCurrency()">Convert</button>

<p id="currencyAnswer"></p>

<script>
function changeCurrency() {

    var amount =
        parseFloat(document.getElementById("amount").value);

    var source =
        document.getElementById("source").value;

    var target =
        document.getElementById("target").value;

    var converted;

    if (source == "Indian Rupee" &&
        target == "US Dollar") {

        converted = amount * 0.015;
    }

    else if (source == "US Dollar" &&
             target == "Indian Rupee") {

        converted = amount * 67.12;
    }

    else {
        converted = amount;
    }

    document.getElementById("currencyAnswer").innerHTML =
        "Converted Amount: " + converted.toFixed(2);
}
</script>

