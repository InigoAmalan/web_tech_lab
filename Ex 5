<h2>2. BMI Calculator</h2>

Enter Weight in kg:
<input type="text" id="weight">

<br><br>

Enter Height in cm:
<input type="text" id="height">

<br><br>

<button onclick="getBMI()">Calculate BMI</button>

<p id="bmiResult"></p>

<script>
function getBMI() {
    var weight = parseFloat(document.getElementById("weight").value);
    var height = parseFloat(document.getElementById("height").value);

    var meter = height / 100;
    var bmi = weight / (meter * meter);

    var body;

    if (bmi < 18) {
        body = "Underweight";
    }
    else if (bmi < 25) {
        body = "Normal";
    }
    else if (bmi < 30) {
        body = "Overweight";
    }
    else {
        body = "Obese";
    }

    document.getElementById("bmiResult").innerHTML =
        "BMI: " + bmi.toFixed(2) + "<br>" +
        "Body Type: " + body;
}
</script>

