<h2>1. Shortest and Longest Word</h2>

<button onclick="checkWords()">Check Words</button>

<p id="wordOutput"></p>

<script>
function checkWords() {
    var text = "Web Development Tutorial";
    var list = text.split(" ");

    var small = list[0];
    var big = list[0];

    for (var i = 1; i < list.length; i++) {
        if (list[i].length < small.length) {
            small = list[i];
        }

        if (list[i].length > big.length) {
            big = list[i];
        }
    }

    document.getElementById("wordOutput").innerHTML =
        "Shortest Word: " + small + "<br>" +
        "Longest Word: " + big;
}
</script>

