<h2>6. Birthday Cake Order</h2>

Half Kg Cakes:
<input type="text" id="half">

<br><br>

One Kg Cakes:
<input type="text" id="one">

<br><br>

Two Kg Cakes:
<input type="text" id="two">

<br><br>

Select Tip:

<input type="radio" name="tip" value="10">
10%

<input type="radio" name="tip" value="15" checked>
15%

<input type="radio" name="tip" value="20">
20%

<br><br>

<button onclick="calculateBill()">
    Calculate Bill
</button>

<p id="bill"></p>

<script>
function calculateBill() {

    var half =
        parseInt(document.getElementById("half").value);

    var one =
        parseInt(document.getElementById("one").value);

    var two =
        parseInt(document.getElementById("two").value);

    var tip =
        document.querySelector(
            'input[name="tip"]:checked'
        ).value;

    var amount =
        (half * 100) +
        (one * 200) +
        (two * 400);

    var tax = amount * 0.09;

    var total = amount + tax;

    total = total + (total * tip / 100);

    document.getElementById("bill").innerHTML =
        "Total Bill: Rs. " + total.toFixed(2);
}
</script>

