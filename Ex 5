</p>

<h3>Coin Reference</h3>

<img
    src="https://commons.wikimedia.org/wiki/Special:Redirect/file/US%20union%20shield%20penny%20reverse.png"
    width="180"
    height="180"
>

<p>Heads and Tails sides of a coin</p>

<script>
var headCount = 0;
var tailCount = 0;

var headsImage =
"https://commons.wikimedia.org/wiki/Special:Redirect/file/US%20One%20Cent%20Obv.png";

var tailsImage =
"https://commons.wikimedia.org/wiki/Special:Redirect/file/US%20union%20shield%20penny%20reverse.png";

function flipCoin() {

    var result = Math.floor(Math.random() * 2);

    if (result == 0) {

        document.getElementById("coin").src =
            headsImage;

        headCount++;
    }

    else {

        document.getElementById("coin").src =
            tailsImage;

        tailCount++;
    }

    document.getElementById("heads").innerHTML =
        headCount;

    document.getElementById("tails").innerHTML =
        tailCount;
}
</script>

