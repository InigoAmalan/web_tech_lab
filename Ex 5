<h2>3. Fruit Farm</h2>

Enter Rows:
<input type="text" id="row">

<br><br>

Enter Columns:
<input type="text" id="col">

<br><br>

<button onclick="createFarm()">Create Farm</button>

<br><br>

<div id="farm"></div>

<script>
function createFarm() {
    var row = parseInt(document.getElementById("row").value);
    var col = parseInt(document.getElementById("col").value);

    var fruit = [
        "https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?w=200",
        "https://images.unsplash.com/photo-1547514701-42782101795e?w=200"
    ];

    var result = "";

    for (var i = 0; i < row; i++) {

        for (var j = 0; j < col; j++) {

            var choice = Math.floor(Math.random() * fruit.length);

            result +=
                "<img src='" + fruit[choice] +
                "' width='100' height='100' style='margin:5px;'>";
        }

        result += "<br>";
    }

    document.getElementById("farm").innerHTML = result;
}
</script>

